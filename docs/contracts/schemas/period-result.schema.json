{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/period-result.schema.json",
  "title": "Unsigned Period V1 result",
  "description": "Contract frozen under Final Decision v3, v2 and approved clarifications. Structural validation is supplemented by semantic vectors; engine readiness is separate.",
  "oneOf": [
    {
      "$ref": "period-result.schema.json#/$defs/Weekly"
    },
    {
      "$ref": "period-result.schema.json#/$defs/Monthly"
    },
    {
      "$ref": "period-result.schema.json#/$defs/Yearly"
    }
  ],
  "$defs": {
    "Weekly": {
      "type": "object",
      "properties": {
        "meta": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/meta"
            },
            {
              "properties": {
                "versions": {
                  "properties": {
                    "configVersion": {
                      "const": "CONFIG_PERIOD_V1"
                    }
                  }
                }
              }
            }
          ]
        },
        "period": {
          "type": "object",
          "properties": {
            "type": {
              "const": "WEEK"
            },
            "startDate": {
              "type": "string",
              "format": "date",
              "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "endDate": {
              "type": "string",
              "format": "date",
              "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Required semantic IANA tzdb validation; no implicit default."
            }
          },
          "required": [
            "type",
            "startDate",
            "endDate",
            "timezone"
          ],
          "additionalProperties": false
        },
        "targetTimezone": {
          "$ref": "common.schema.json#/$defs/timezone"
        },
        "resultConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.0001
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.0001
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warnings"
        },
        "features": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "feature.schema.json"
              },
              {
                "properties": {
                  "source": {
                    "const": "SAJU"
                  }
                }
              }
            ]
          },
          "maxItems": 0
        },
        "weeklyScore": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "multipleOf": 0.0001
            },
            {
              "type": "null"
            }
          ]
        },
        "bestDays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "multipleOf": 0.0001
              },
              "resultConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "multipleOf": 0.0001
              }
            },
            "required": [
              "date",
              "score",
              "resultConfidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 2
        },
        "cautionDays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "multipleOf": 0.0001
              },
              "resultConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "multipleOf": 0.0001
              }
            },
            "required": [
              "date",
              "score",
              "resultConfidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 2
        },
        "volatility": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "multipleOf": 0.0001,
              "maximum": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "CAUTION",
            "BALANCED",
            "GOOD",
            "VERY_GOOD",
            "EXCELLENT",
            "INSUFFICIENT_DATA"
          ]
        },
        "trendStatus": {
          "enum": [
            "STABLE",
            "NOTICEABLE",
            "SIGNIFICANT",
            "INSUFFICIENT_DATA"
          ]
        },
        "slope": {
          "anyOf": [
            {
              "type": "number",
              "multipleOf": 0.0001
            },
            {
              "type": "null"
            }
          ]
        },
        "periodDelta": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 100,
          "description": "Internal full-precision periodScore minus lifetimeScore; not the difference of rounded wire scores.",
          "multipleOf": 0.0001
        },
        "trendDirection": {
          "enum": [
            "STABLE",
            "UP",
            "DOWN",
            "UNKNOWN"
          ]
        },
        "zodiacContext": {
          "$ref": "zodiac-context.schema.json"
        }
      },
      "required": [
        "meta",
        "period",
        "targetTimezone",
        "resultConfidence",
        "coverage",
        "warnings",
        "features",
        "weeklyScore",
        "bestDays",
        "cautionDays",
        "volatility",
        "status",
        "periodDelta",
        "trendStatus",
        "trendDirection"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "weeklyScore": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "INSUFFICIENT_DATA"
              },
              "resultConfidence": {
                "const": 0
              },
              "periodDelta": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "not": {
                  "const": "INSUFFICIENT_DATA"
                }
              },
              "periodDelta": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CAUTION"
              }
            }
          },
          "then": {
            "properties": {
              "weeklyScore": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 45
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "BALANCED"
              }
            }
          },
          "then": {
            "properties": {
              "weeklyScore": {
                "type": "number",
                "minimum": 45,
                "exclusiveMaximum": 60
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "GOOD"
              }
            }
          },
          "then": {
            "properties": {
              "weeklyScore": {
                "type": "number",
                "minimum": 60,
                "exclusiveMaximum": 75
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERY_GOOD"
              }
            }
          },
          "then": {
            "properties": {
              "weeklyScore": {
                "type": "number",
                "minimum": 75,
                "exclusiveMaximum": 85
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "EXCELLENT"
              }
            }
          },
          "then": {
            "properties": {
              "weeklyScore": {
                "type": "number",
                "minimum": 85,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "periodDelta": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "trendStatus": {
                "const": "INSUFFICIENT_DATA"
              },
              "trendDirection": {
                "const": "UNKNOWN"
              }
            }
          }
        }
      ]
    },
