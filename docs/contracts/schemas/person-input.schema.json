{
  "type": "object",
  "properties": {
    "birthDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "birthLocationId": {
      "type": "string",
      "minLength": 1
    },
    "birthTime": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "birthDate",
    "birthLocationId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/person-input.schema.json",
  "title": "LOVE FORTUNE person-input v2",
  "description": "Contract frozen under Final Decision v3, v2 and approved clarifications. Structural validation is supplemented by semantic vectors; engine readiness is separate."
}
