{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/context-interpretation.schema.json",
  "type": "object",
  "properties": {
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "context-evidence.schema.json"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "contextEvidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ce_[0-9a-f]{48}$"
            }
          }
        },
        "required": [
          "text",
          "contextEvidenceRefs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contextEvidence",
    "interpretations"
  ],
  "additionalProperties": false
}
