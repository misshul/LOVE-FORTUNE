{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/common.schema.json",
  "title": "LOVE FORTUNE common v2",
  "description": "Contract frozen under Final Decision v3, v2 and approved clarifications. Structural validation is supplemented by semantic vectors; engine readiness is separate.",
  "$defs": {
    "category": {
      "enum": [
        "ATTRACTION",
        "EMOTION",
        "COMMUNICATION",
        "PASSION",
        "STABILITY",
        "HARMONY",
        "SUPPORT",
        "LONG_TERM"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "multipleOf": 0.0001
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "Required semantic IANA tzdb validation; no implicit default."
    },
    "versions": {
      "type": "object",
      "properties": {
        "serviceVersion": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "const": "v1"
        },
        "sajuEngineVersion": {
          "type": "string",
          "minLength": 1
        },
        "scoreVersion": {
          "const": "SCORE_ZODIAC_V1"
        },
        "configVersion": {
          "type": "string",
          "minLength": 1
        },
        "locationReferenceVersion": {
          "type": "string",
          "minLength": 1
        },
        "timezoneDataVersion": {
          "type": "string",
          "minLength": 1
        },
        "zodiacEngineVersion": {
          "const": "FIXED_DATE_SINGLE_SIGN_V1"
        },
        "zodiacCatalogVersion": {
          "const": "ZODIAC_CATALOG_V1"
        },
        "zodiacDateRangeVersion": {
          "const": "ZODIAC_DATE_RANGE_V1"
        }
      },
      "required": [
        "serviceVersion",
        "apiVersion",
        "sajuEngineVersion",
        "scoreVersion",
        "configVersion",
        "locationReferenceVersion",
        "timezoneDataVersion",
        "zodiacEngineVersion",
        "zodiacCatalogVersion",
        "zodiacDateRangeVersion"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "$ref": "common.schema.json#/$defs/versions"
        }
      },
      "required": [
        "requestId",
        "versions"
      ],
      "additionalProperties": false
    },
    "categoryScore": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "multipleOf": 0.0001
            },
            "status": {
              "enum": [
                "CAUTION",
                "BALANCED",
                "GOOD",
                "VERY_GOOD",
                "EXCELLENT"
              ]
            },
            "resultConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "score",
            "status",
            "resultConfidence",
            "coverage"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "CAUTION"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 45
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "BALANCED"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 45,
                    "exclusiveMaximum": 60
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "GOOD"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 60,
                    "exclusiveMaximum": 75
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "VERY_GOOD"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 75,
                    "exclusiveMaximum": 85
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "EXCELLENT"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 85,
                    "maximum": 100
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": "null"
            },
            "status": {
              "const": "INSUFFICIENT_DATA"
            },
            "resultConfidence": {
              "const": 0
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Structural available/eligible weight ratio retained even with no usable evidence."
            }
          },
          "required": [
            "score",
            "status",
            "resultConfidence",
            "coverage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "period": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "LIFETIME"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DAY"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Required semantic IANA tzdb validation; no implicit default."
            }
          },
          "required": [
            "type",
            "date",
            "timezone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "WEEK"
            },
            "startDate": {
              "type": "string",
              "format": "date",
              "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "endDate": {
              "type": "string",
              "format": "date",
              "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Required semantic IANA tzdb validation; no implicit default."
            }
          },
          "required": [
            "type",
            "startDate",
            "endDate",
            "timezone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "MONTH"
            },
            "year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2099
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Required semantic IANA tzdb validation; no implicit default."
            }
          },
          "required": [
            "type",
            "year",
            "month",
            "timezone"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "YEAR"
            },
            "year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2099
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "Required semantic IANA tzdb validation; no implicit default."
            }
          },
          "required": [
            "type",
            "year",
            "timezone"
          ],
          "additionalProperties": false
        }
      ]
    },
    "locale": {
      "enum": [
        "ko-KR",
        "ja-JP",
        "en-US"
      ],
      "default": "ko-KR"
    },
    "contextCategory": {
      "type": "object",
      "properties": {
        "score": {
          "type": "null"
        },
        "status": {
          "const": "INSUFFICIENT_DATA"
        },
        "coverage": {
          "const": 0
        },
        "resultConfidence": {
          "const": 0
        }
      },
      "required": [
        "score",
        "status",
        "coverage",
        "resultConfidence"
      ],
      "additionalProperties": false
    }
  }
}
