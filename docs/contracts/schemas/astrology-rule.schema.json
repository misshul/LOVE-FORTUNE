{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/astrology-rule.schema.json",
  "title": "LOVE FORTUNE Astrology scoring rule v1",
  "description": "Closed scoring-rule structure. Aspect exact angles and orbs resolve through catalog aspectDefinitions/referenceTables; semantic validator checks identity, pair weight, mapping approval and deferred scope. Generic Saju schema is unchanged.",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^ASTRO_[A-Z]+_[A-Z]+_(CONJUNCTION|OPPOSITION|TRINE|SQUARE|SEXTILE)$"
    },
    "source": {
      "const": "ASTROLOGY"
    },
    "enabled": {
      "type": "boolean"
    },
    "planetA": {
      "enum": [
        "SUN",
        "MOON",
        "MERCURY",
        "VENUS",
        "MARS",
        "JUPITER",
        "SATURN",
        "URANUS",
        "NEPTUNE",
        "PLUTO"
      ]
    },
    "planetB": {
      "enum": [
        "SUN",
        "MOON",
        "MERCURY",
        "VENUS",
        "MARS",
        "JUPITER",
        "SATURN",
        "URANUS",
        "NEPTUNE",
        "PLUTO"
      ]
    },
    "aspect": {
      "enum": [
        "CONJUNCTION",
        "TRINE",
        "SEXTILE",
        "SQUARE",
        "OPPOSITION"
      ]
    },
    "categoryMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "ATTRACTION",
              "EMOTION",
              "COMMUNICATION",
              "PASSION",
              "STABILITY",
              "HARMONY",
              "SUPPORT",
              "LONG_TERM"
            ]
          },
          "direction": {
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL"
            ]
          },
          "signedValue": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "category",
          "direction",
          "signedValue"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "POSITIVE"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "NEGATIVE"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "exclusiveMaximum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "NEUTRAL"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    },
    "baseWeight": {
      "type": "number",
      "minimum": 0
    },
    "ruleWeight": {
      "const": 1
    },
    "pairWeight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pairWeightSource": {
      "enum": [
        "OVERRIDE",
        "GENERIC"
      ]
    },
    "requiresBirthTime": {
      "const": false
    },
    "contextOnly": {
      "const": false
    },
    "version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "ruleId",
    "source",
    "enabled",
    "planetA",
    "planetB",
    "aspect",
    "categoryMappings",
    "baseWeight",
    "ruleWeight",
    "pairWeight",
    "pairWeightSource",
    "requiresBirthTime",
    "contextOnly",
    "version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "categoryMappings": {
            "minItems": 1
          },
          "planetA": {
            "enum": [
              "SUN",
              "MOON",
              "MERCURY",
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN"
            ]
          },
          "planetB": {
            "enum": [
              "SUN",
              "MOON",
              "MERCURY",
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "SUN"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "SUN",
              "MOON",
              "MERCURY",
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "MOON"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "MOON",
              "MERCURY",
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "MERCURY"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "MERCURY",
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "VENUS"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "VENUS",
              "MARS",
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "MARS"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "MARS",
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "JUPITER"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "JUPITER",
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "SATURN"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "SATURN",
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "URANUS"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "URANUS",
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "NEPTUNE"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "NEPTUNE",
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planetA": {
            "const": "PLUTO"
          }
        }
      },
      "then": {
        "properties": {
          "planetB": {
            "enum": [
              "PLUTO"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "CONJUNCTION"
          }
        }
      },
      "then": {
        "properties": {
          "baseWeight": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "TRINE"
          }
        }
      },
      "then": {
        "properties": {
          "baseWeight": {
            "const": 0.9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "SEXTILE"
          }
        }
      },
      "then": {
        "properties": {
          "baseWeight": {
            "const": 0.7
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "SQUARE"
          }
        }
      },
      "then": {
        "properties": {
          "baseWeight": {
            "const": 0.85
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspect": {
            "const": "OPPOSITION"
          }
        }
      },
      "then": {
        "properties": {
          "baseWeight": {
            "const": 0.9
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "planetB": {
                  "const": "JUPITER"
                },
                "aspect": {
                  "enum": [
                    "SQUARE",
                    "OPPOSITION"
                  ]
                }
              }
            },
            {
              "properties": {
                "planetA": {
                  "enum": [
                    "JUPITER",
                    "SATURN"
                  ]
                }
              }
            },
            {
              "properties": {
                "planetA": {
                  "const": "MARS"
                },
                "planetB": {
                  "const": "SATURN"
                }
              }
            },
            {
              "properties": {
                "planetA": {
                  "const": "MERCURY"
                },
                "planetB": {
                  "const": "SATURN"
                },
                "aspect": {
                  "const": "CONJUNCTION"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
