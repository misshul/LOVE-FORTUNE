{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/daily-range-response.schema.json",
  "title": "LOVE FORTUNE daily-range-response v2",
  "description": "Contract frozen under Final Decision v3, v2 and approved clarifications. Structural validation is supplemented by semantic vectors; engine readiness is separate.",
  "type": "object",
  "properties": {
    "meta": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/meta"
        },
        {
          "properties": {
            "versions": {
              "properties": {
                "configVersion": {
                  "const": "CONFIG_PERIOD_V1"
                }
              }
            }
          }
        }
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "targetTimezone": {
      "$ref": "common.schema.json#/$defs/timezone"
    },
    "days": {
      "type": "array",
      "items": {
        "$ref": "daily-result.schema.json"
      },
      "maxItems": 31,
      "minItems": 1
    }
  },
  "required": [
    "meta",
    "startDate",
    "endDate",
    "targetTimezone",
    "days"
  ],
  "additionalProperties": false
}
