{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/schemas/daily-rule.schema.json",
  "title": "Daily v1 scoring rule; separate from Lifetime",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^DAILY_(ASTRO|SAJU)_[A-Z_]+$"
    },
    "source": {
      "enum": [
        "ASTROLOGY",
        "SAJU"
      ]
    },
    "enabled": {
      "const": true
    },
    "requiresBirthTime": {
      "const": false
    },
    "contextOnly": {
      "const": false
    },
    "version": {
      "const": "1.0.0"
    },
    "pairWeight": {
      "const": 1
    },
    "sampleIdentity": {
      "const": "NOMINAL_LOCAL_SLOT"
    },
    "baseWeight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ruleWeight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "categoryMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "ATTRACTION",
              "EMOTION",
              "COMMUNICATION",
              "PASSION",
              "STABILITY",
              "HARMONY",
              "SUPPORT",
              "LONG_TERM"
            ]
          },
          "direction": {
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "NEUTRAL"
            ]
          },
          "signedValue": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "category",
          "direction",
          "signedValue"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "POSITIVE"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "NEGATIVE"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "exclusiveMaximum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "direction": {
                  "const": "NEUTRAL"
                }
              }
            },
            "then": {
              "properties": {
                "signedValue": {
                  "const": 0
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "transitPlanet": {
      "enum": [
        "SUN",
        "MOON",
        "MERCURY",
        "VENUS",
        "MARS"
      ]
    },
    "natalPlanet": {
      "enum": [
        "SUN",
        "MOON",
        "MERCURY",
        "VENUS",
        "MARS"
      ]
    },
    "aspect": {
      "enum": [
        "CONJUNCTION",
        "SEXTILE",
        "SQUARE",
        "TRINE",
        "OPPOSITION"
      ]
    },
    "orbPolicy": {
      "const": {
        "degrees": 1,
        "inclusive": true,
        "planetAdjustment": "NONE",
        "closenessUsage": "METADATA_ONLY"
      }
    },
    "relationOwner": {
      "enum": [
        "STEM",
        "BRANCH"
      ]
    },
    "relation": {
      "enum": [
        "COMBINATION",
        "SAME",
        "GENERATION",
        "CONTROL",
        "LIUHE",
        "CLASH"
      ]
    },
    "referenceId": {
      "const": "DAILY_SAJU_REFERENCE_V1"
    },
    "weightSource": {
      "enum": [
        "STEM_COMBINATION",
        "DAY_MASTER_RELATION",
        "ELEMENT_SUPPORT",
        "ELEMENT_CONTROL",
        "BRANCH_COMBINATION",
        "BRANCH_CLASH",
        "DAY_BRANCH_RELATION"
      ]
    }
  },
  "required": [
    "enabled",
    "requiresBirthTime",
    "contextOnly",
    "version",
    "pairWeight",
    "sampleIdentity",
    "ruleId",
    "source",
    "baseWeight",
    "ruleWeight",
    "categoryMappings"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "source": {
          "const": "ASTROLOGY"
        },
        "ruleId": {
          "pattern": "^DAILY_ASTRO_"
        }
      },
      "required": [
        "transitPlanet",
        "natalPlanet",
        "aspect",
        "orbPolicy"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "relationOwner"
            ]
          },
          {
            "required": [
              "relation"
            ]
          },
          {
            "required": [
              "referenceId"
            ]
          },
          {
            "required": [
              "weightSource"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "source": {
          "const": "SAJU"
        },
        "ruleId": {
          "pattern": "^DAILY_SAJU_"
        },
        "ruleWeight": {
          "const": 1
        }
      },
      "required": [
        "relationOwner",
        "relation",
        "referenceId",
        "weightSource"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "transitPlanet"
            ]
          },
          {
            "required": [
              "natalPlanet"
            ]
          },
          {
            "required": [
              "aspect"
            ]
          },
          {
            "required": [
              "orbPolicy"
            ]
          }
        ]
      }
    }
  ]
}
