{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://love-fortune.invalid/contracts/advanced/schemas/interpretation-response.schema.json",
  "title": "LOVE FORTUNE interpretation-response v2",
  "description": "Contract frozen under Final Decision v3, v2 and approved clarifications. Structural validation is supplemented by semantic vectors; engine readiness is separate.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/versions"
        },
        "aiPromptVersion": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "interpretationMode": {
          "enum": [
            "AI",
            "FALLBACK"
          ]
        }
      },
      "required": [
        "requestId",
        "versions",
        "aiPromptVersion",
        "provider",
        "model",
        "interpretationMode"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "text",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "advice": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "meta",
    "summary",
    "strengths",
    "challenges",
    "advice"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "interpretationMode": {
                "const": "AI"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
