                "properties": {
                  "status": {
                    "const": "INSUFFICIENT_DATA"
                  }
                }
              },
              "LONG_TERM": {
                "properties": {
                  "status": {
                    "const": "INSUFFICIENT_DATA"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "enum": [
              "CAUTION",
              "BALANCED",
              "GOOD",
              "VERY_GOOD",
              "EXCELLENT"
