        },
        "LONG_TERM": {
          "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/categoryScore"
        }
      },
      "required": [
        "ATTRACTION",
        "EMOTION",
        "COMMUNICATION",
        "PASSION",
        "STABILITY",
        "HARMONY",
        "SUPPORT",
        "LONG_TERM"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/feature.schema.json"
      }
    },
    "warnings": {
      "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/warnings"
    },
    "signedInterpretationContext": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "meta",
    "overallScore",
    "status",
    "resultConfidence",
    "coverage",
    "categories",
    "features",
    "warnings"
  ],
  "additionalProperties": false,
