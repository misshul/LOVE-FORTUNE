              },
              "PASSION": {
                "properties": {
                  "status": {
                    "const": "INSUFFICIENT_DATA"
                  }
                }
              },
              "STABILITY": {
                "properties": {
                  "status": {
                    "const": "INSUFFICIENT_DATA"
                  }
                }
              },
              "HARMONY": {
                "properties": {
                  "status": {
                    "const": "INSUFFICIENT_DATA"
                  }
