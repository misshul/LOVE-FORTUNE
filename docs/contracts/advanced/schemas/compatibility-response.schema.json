  "$id": "https://love-fortune.invalid/contracts/advanced/schemas/compatibility-response.schema.json",
  "title": "LOVE FORTUNE compatibility-response v2",
  "description": "ADVANCED / DEFERRED. Preserved pre-Zodiac contract; never selected by V1 OpenAPI.",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/meta"
