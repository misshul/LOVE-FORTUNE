      "minimum": 0,
      "maximum": 1
    },
    "categories": {
      "type": "object",
      "properties": {
        "ATTRACTION": {
          "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/categoryScore"
        },
        "EMOTION": {
          "$ref": "https://love-fortune.invalid/contracts/advanced/schemas/common.schema.json#/$defs/categoryScore"
